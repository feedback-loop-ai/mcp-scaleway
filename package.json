{
	"name": "mcp-scaleway",
	"version": "0.1.0",
	"description": "MCP server for Scaleway cloud provider",
	"type": "module",
	"main": "src/server.ts",
	"scripts": {
		"start": "bun run src/main.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run --config tests/vitest.config.ts",
		"test:watch": "vitest --config tests/vitest.config.ts",
		"test:parity": "vitest run --config tests/vitest.config.ts -- parity"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.25.0",
		"@scaleway/sdk-account": "^2.3.1",
		"@scaleway/sdk-client": "^1.0.0",
		"@scaleway/sdk-key-manager": "^2.3.1",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/bun": "^1.3.10",
		"@vitest/coverage-v8": "^3.0.0",
		"vitest": "^3.0.0"
	}
}
