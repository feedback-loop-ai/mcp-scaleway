{
	"name": "mcp-scaleway",
	"version": "0.4.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/feedback-loop-ai/mcp-scaleway"
	},
	"description": "MCP server for Scaleway cloud provider",
	"type": "module",
	"main": "./dist/server.js",
	"bin": {
		"mcp-scaleway": "./dist/index.js"
	},
	"files": ["dist/", "README.md", "CHANGELOG.md", "LICENSE"],
	"engines": {
		"node": ">=20.20.2"
	},
	"scripts": {
		"start": "bun run src/main.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run --config tests/vitest.config.ts",
		"test:watch": "vitest --config tests/vitest.config.ts",
		"test:parity": "vitest run --config tests/vitest.config.ts tests/unit/parity.test.ts",
		"build": "bun run bun.build.ts",
		"gen:operations": "bun run scripts/gen-operations.ts",
		"measure:discovery": "bun run scripts/measure-discovery.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.25.0",
		"@scaleway/sdk-account": "^2.3.1",
		"@scaleway/sdk-client": "^2.7.0",
		"@scaleway/sdk-edge-services": "^2.7.0",
		"@scaleway/sdk-key-manager": "^2.3.1",
		"@scaleway/sdk-mnq": "^2.3.1",
		"@scaleway/sdk-secret": "^2.3.1",
		"zod": "^3.25.0",
		"zod-to-json-schema": "3.25.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/bun": "^1.3.10",
		"@vitest/coverage-v8": "^3.0.0",
		"vitest": "^3.0.0"
	}
}
